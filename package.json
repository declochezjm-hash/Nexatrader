{
  "name": "nexatrader",
  "version": "0.1.0",
  "description": "Application de trading autonome XAUUSD / NAS100 avec PropGuard Ultra et IA locale",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "test:pretrade": "node scripts/test-pretrade-validation.mjs",
    "test:wgf": "node scripts/test-wgf-programs.mjs",
    "test:wgf-daily": "node scripts/test-wgf-daily-reset.mjs",
    "test:wgf-eod": "node scripts/test-wgf-eod-trailing.mjs",
    "test:wgf-profit": "node scripts/test-wgf-profit-target.mjs",
    "test:wgf-compliance": "node scripts/test-wgf-compliance.mjs",
    "test:wgf-enforcement": "node scripts/test-wgf-enforcement.mjs",
    "test:wgf-whatif": "node scripts/test-wgf-whatif.mjs",
    "test:wgf-readiness": "node scripts/test-wgf-readiness.mjs",
    "test:wgf-audit": "node scripts/test-wgf-audit.mjs",
    "test:wgf-odp": "node scripts/test-wgf-one-day-pass.mjs",
    "test:wgf-export": "node scripts/test-wgf-export.mjs",
    "test:innovation": "node scripts/test-innovation-features.mjs",
    "test:wgf-all": "npm run test:wgf && npm run test:wgf-daily && npm run test:wgf-eod && npm run test:wgf-profit && npm run test:wgf-compliance && npm run test:wgf-enforcement && npm run test:wgf-whatif && npm run test:wgf-readiness && npm run test:wgf-audit && npm run test:wgf-odp && npm run test:wgf-export",
    "start": "cross-env NODE_ENV=production electron .",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "lightweight-charts": "^4.2.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "vite": "^6.0.3",
    "wait-on": "^8.0.1"
  }
}
