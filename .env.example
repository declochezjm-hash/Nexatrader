# Copiez ce fichier en .env à la racine du projet (optionnel).
# Clé Gemini (recommandé) — https://aistudio.google.com/apikey avec votre compte Google
GEMINI_API_KEY=

# OAuth Google (optionnel — pour « Continuer avec Google » sans coller de clé)
NEXATRADER_GOOGLE_CLIENT_ID=votre-id.apps.googleusercontent.com

# Données marché live (gratuit avec inscription) — alternative à Paramètres → Données marché
TWELVEDATA_API_KEY=
FINNHUB_API_KEY=
